{
  "name": "amharic-motion-graphics",
  "version": "1.0.0",
  "private": true,
  "description": "Audio-directed Amharic motion graphics (Remotion), rendered by GitHub Actions",
  "scripts": {
    "prepare:fonts": "node scripts/prepare-fonts.mjs",
    "prepare:cues": "node scripts/build-cues.mjs",
    "prepare:assets": "npm run prepare:fonts && npm run prepare:cues",
    "validate": "node scripts/validate-cues.mjs",
    "validate:strict": "node scripts/validate-cues.mjs --strict",
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio src/index.ts",
    "stills": "node scripts/render-stills.mjs",
    "render": "remotion render src/index.ts FinalVideo output/final-amharic-motion-graphics.mp4",
    "verify": "node scripts/verify-output.mjs",
    "build:all": "npm run prepare:assets && npm run validate:strict && npm run stills && npm run render && npm run verify"
  },
  "dependencies": {
    "@fontsource/noto-sans-ethiopic": "^5.0.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "^5.6.0"
  }
}
